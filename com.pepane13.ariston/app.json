{
  "id": "com.pepane13.ariston",
  "version": "2.0.2",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Ariston Nuos",
    "fr": "Ariston Nuos"
  },
  "description": {
    "en": "Control your Ariston Nuos heat pump water heater from Homey and your Flows",
    "fr": "Pilotez votre chauffe-eau thermodynamique Ariston Nuos depuis Homey et vos Flows"
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Stéphane Renaudet",
    "email": "stephane.renaudet@gmail.com"
  },
  "brandColor": "#0F6FB5",
  "support": "https://github.com/Pepane13/Ariston-Nuos/issues",
  "source": "https://github.com/Pepane13/Ariston-Nuos",
  "capabilities": {
    "ariston_mode": {
      "type": "enum",
      "title": {
        "en": "Mode",
        "fr": "Mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "green",
          "title": {
            "en": "Green",
            "fr": "Green"
          }
        },
        {
          "id": "comfort",
          "title": {
            "en": "Comfort",
            "fr": "Comfort"
          }
        },
        {
          "id": "fast",
          "title": {
            "en": "Fast",
            "fr": "Fast"
          }
        },
        {
          "id": "imemory",
          "title": {
            "en": "i-Memory",
            "fr": "i-Memory"
          }
        }
      ],
      "icon": "/assets/capabilities/mode.svg"
    },
    "ariston_boost": {
      "type": "boolean",
      "title": {
        "en": "Boost",
        "fr": "Boost"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Boost on",
        "fr": "Boost activé"
      },
      "insightsTitleFalse": {
        "en": "Boost off",
        "fr": "Boost désactivé"
      },
      "icon": "/assets/capabilities/boost.svg"
    },
    "ariston_heatpump": {
      "type": "boolean",
      "title": {
        "en": "Heat pump running",
        "fr": "Pompe à chaleur en marche"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Heat pump started",
        "fr": "Pompe à chaleur démarrée"
      },
      "insightsTitleFalse": {
        "en": "Heat pump stopped",
        "fr": "Pompe à chaleur arrêtée"
      },
      "icon": "/assets/capabilities/heatpump.svg"
    },
    "ariston_energy": {
      "type": "number",
      "title": {
        "en": "Energy, last day",
        "fr": "Énergie, dernier jour"
      },
      "units": {
        "en": "kWh",
        "fr": "kWh"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/energy.svg"
    },
    "ariston_automation": {
      "type": "boolean",
      "title": {
        "en": "Automatic strategy",
        "fr": "Stratégie automatique"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/capabilities/auto.svg"
    },
    "ariston_rule": {
      "type": "string",
      "title": {
        "en": "Active rule",
        "fr": "Règle active"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/auto.svg"
    },
    "ariston_legionella": {
      "type": "string",
      "title": {
        "en": "Last anti-legionella",
        "fr": "Dernière anti-légionellose"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/legionella.svg"
    }
  },
  "drivers": [
    {
      "id": "nuos",
      "name": {
        "en": "Ariston Nuos",
        "fr": "Ariston Nuos"
      },
      "class": "waterheater",
      "capabilities": [
        "onoff",
        "measure_temperature",
        "target_temperature",
        "ariston_mode",
        "ariston_boost",
        "ariston_heatpump",
        "ariston_energy.hp",
        "ariston_energy.resistor"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 40,
          "max": 75,
          "step": 1,
          "decimals": 0
        },
        "measure_temperature": {
          "title": {
            "en": "Water temperature",
            "fr": "Température de l'eau"
          }
        },
        "onoff": {
          "title": {
            "en": "Water heater on",
            "fr": "Chauffe-eau allumé"
          }
        },
        "ariston_energy.hp": {
          "title": {
            "en": "Heat pump energy, last day",
            "fr": "Énergie PAC, dernier jour"
          }
        },
        "ariston_energy.resistor": {
          "title": {
            "en": "Resistor energy, last day",
            "fr": "Énergie résistance, dernier jour"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/nuos/assets/images/small.png",
        "large": "/drivers/nuos/assets/images/large.png",
        "xlarge": "/drivers/nuos/assets/images/xlarge.png"
      },
      "icon": "/drivers/nuos/assets/icon.svg",
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Ariston NET account",
              "fr": "Compte Ariston NET"
            },
            "usernameLabel": {
              "en": "E-mail",
              "fr": "E-mail"
            },
            "usernamePlaceholder": "name@example.com",
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            },
            "passwordPlaceholder": ""
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Ariston NET account",
              "fr": "Compte Ariston NET"
            },
            "usernameLabel": {
              "en": "E-mail",
              "fr": "E-mail"
            },
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            }
          }
        }
      ],
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Cloud polling interval",
            "fr": "Intervalle de lecture du cloud"
          },
          "value": 2,
          "attr": {
            "min": 1,
            "max": 15,
            "step": 1
          },
          "units": {
            "en": "min",
            "fr": "min"
          },
          "hint": {
            "en": "The Ariston cloud limits the number of requests: keep 2 min or more.",
            "fr": "Le cloud Ariston limite le nombre de requêtes : garder 2 min ou plus."
          }
        },
        {
          "id": "gateway",
          "type": "label",
          "label": {
            "en": "Gateway",
            "fr": "Passerelle"
          },
          "value": ""
        },
        {
          "id": "whe_type",
          "type": "label",
          "label": {
            "en": "Model",
            "fr": "Modèle"
          },
          "value": ""
        },
        {
          "id": "limits",
          "type": "label",
          "label": {
            "en": "Setpoint limits",
            "fr": "Limites de consigne"
          },
          "value": ""
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "mode_changed",
        "title": {
          "en": "The mode changed",
          "fr": "Le mode a changé"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "example": "Green"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          }
        ]
      },
      {
        "id": "cloud_error",
        "title": {
          "en": "The Ariston cloud is unreachable",
          "fr": "Le cloud Ariston est injoignable"
        },
        "tokens": [
          {
            "name": "error",
            "type": "string",
            "title": {
              "en": "Error",
              "fr": "Erreur"
            },
            "example": "HTTP 503"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "mode_is",
        "title": {
          "en": "Mode !{{is|is not}}",
          "fr": "Le mode !{{est|n'est pas}}"
        },
        "titleFormatted": {
          "en": "Mode !{{is|is not}} [[mode]]",
          "fr": "Le mode !{{est|n'est pas}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "values": [
              {
                "id": "green",
                "label": {
                  "en": "Green",
                  "fr": "Green"
                }
              },
              {
                "id": "comfort",
                "label": {
                  "en": "Comfort",
                  "fr": "Comfort"
                }
              },
              {
                "id": "fast",
                "label": {
                  "en": "Fast",
                  "fr": "Fast"
                }
              },
              {
                "id": "imemory",
                "label": {
                  "en": "i-Memory",
                  "fr": "i-Memory"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "boost_on",
        "title": {
          "en": "Boost !{{is|is not}} on",
          "fr": "Le boost !{{est|n'est pas}} activé"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          }
        ]
      },
      {
        "id": "heatpump_running",
        "title": {
          "en": "Heat pump !{{is|is not}} running",
          "fr": "La pompe à chaleur !{{est|n'est pas}} en marche"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_mode",
        "title": {
          "en": "Set the mode",
          "fr": "Régler le mode"
        },
        "titleFormatted": {
          "en": "Set the mode to [[mode]]",
          "fr": "Régler le mode sur [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "values": [
              {
                "id": "green",
                "label": {
                  "en": "Green",
                  "fr": "Green"
                }
              },
              {
                "id": "comfort",
                "label": {
                  "en": "Comfort",
                  "fr": "Comfort"
                }
              },
              {
                "id": "fast",
                "label": {
                  "en": "Fast",
                  "fr": "Fast"
                }
              },
              {
                "id": "imemory",
                "label": {
                  "en": "i-Memory",
                  "fr": "i-Memory"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_boost",
        "title": {
          "en": "Switch boost",
          "fr": "Activer ou couper le boost"
        },
        "titleFormatted": {
          "en": "Switch boost [[state]]",
          "fr": "Boost : [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          },
          {
            "type": "dropdown",
            "name": "state",
            "title": {
              "en": "State",
              "fr": "État"
            },
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "On",
                  "fr": "Activé"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "Off",
                  "fr": "Désactivé"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "refresh",
        "title": {
          "en": "Refresh from the Ariston cloud",
          "fr": "Actualiser depuis le cloud Ariston"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=nuos"
          }
        ]
      }
    ]
  }
}
