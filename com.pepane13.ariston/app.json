{
  "id": "com.pepane13.ariston",
  "version": "1.0.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Ariston Nuos",
    "fr": "Ariston Nuos"
  },
  "description": {
    "en": "Control your Ariston Nuos heat pump water heater with solar, battery and EDF Tempo rules",
    "fr": "Pilotez votre chauffe-eau thermodynamique Ariston Nuos selon le solaire, la batterie et EDF Tempo"
  },
  "category": [
    "climate"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Stéphane Renaudet",
    "email": "stephane.renaudet@gmail.com"
  },
  "brandColor": "#0F6FB5",
  "support": "https://github.com/Pepane13/Ariston-Nuos/issues",
  "source": "https://github.com/Pepane13/Ariston-Nuos",
  "api": {
    "getSources": {
      "method": "GET",
      "path": "/sources"
    },
    "setSources": {
      "method": "PUT",
      "path": "/sources"
    }
  },
  "capabilities": {
    "ariston_mode": {
      "type": "enum",
      "title": {
        "en": "Mode",
        "fr": "Mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "green",
          "title": {
            "en": "Green",
            "fr": "Green"
          }
        },
        {
          "id": "comfort",
          "title": {
            "en": "Comfort",
            "fr": "Comfort"
          }
        },
        {
          "id": "fast",
          "title": {
            "en": "Fast",
            "fr": "Fast"
          }
        },
        {
          "id": "imemory",
          "title": {
            "en": "i-Memory",
            "fr": "i-Memory"
          }
        }
      ],
      "icon": "/assets/capabilities/mode.svg"
    },
    "ariston_boost": {
      "type": "boolean",
      "title": {
        "en": "Boost",
        "fr": "Boost"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Boost on",
        "fr": "Boost activé"
      },
      "insightsTitleFalse": {
        "en": "Boost off",
        "fr": "Boost désactivé"
      },
      "icon": "/assets/capabilities/boost.svg"
    },
    "ariston_heatpump": {
      "type": "boolean",
      "title": {
        "en": "Heat pump running",
        "fr": "Pompe à chaleur en marche"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Heat pump started",
        "fr": "Pompe à chaleur démarrée"
      },
      "insightsTitleFalse": {
        "en": "Heat pump stopped",
        "fr": "Pompe à chaleur arrêtée"
      },
      "icon": "/assets/capabilities/heatpump.svg"
    },
    "ariston_automation": {
      "type": "boolean",
      "title": {
        "en": "Automatic strategy",
        "fr": "Stratégie automatique"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/capabilities/auto.svg"
    },
    "ariston_rule": {
      "type": "string",
      "title": {
        "en": "Active rule",
        "fr": "Règle active"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/auto.svg"
    },
    "ariston_legionella": {
      "type": "string",
      "title": {
        "en": "Last anti-legionella",
        "fr": "Dernière anti-légionellose"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/legionella.svg"
    },
    "ariston_energy": {
      "type": "number",
      "title": {
        "en": "Energy, last day",
        "fr": "Énergie, dernier jour"
      },
      "units": {
        "en": "kWh",
        "fr": "kWh"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/energy.svg"
    }
  },
  "drivers": [
    {
      "id": "nuos",
      "name": {
        "en": "Ariston Nuos",
        "fr": "Ariston Nuos"
      },
      "class": "waterheater",
      "capabilities": [
        "onoff",
        "measure_temperature",
        "target_temperature",
        "ariston_mode",
        "ariston_boost",
        "ariston_heatpump",
        "ariston_automation",
        "ariston_rule",
        "ariston_legionella",
        "ariston_energy.hp",
        "ariston_energy.resistor"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 40,
          "max": 75,
          "step": 1,
          "decimals": 0
        },
        "measure_temperature": {
          "title": {
            "en": "Water temperature",
            "fr": "Température de l'eau"
          }
        },
        "onoff": {
          "title": {
            "en": "Water heater on",
            "fr": "Chauffe-eau allumé"
          }
        },
        "ariston_energy.hp": {
          "title": {
            "en": "Heat pump energy, last day",
            "fr": "Énergie PAC, dernier jour"
          }
        },
        "ariston_energy.resistor": {
          "title": {
            "en": "Resistor energy, last day",
            "fr": "Énergie résistance, dernier jour"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/nuos/assets/images/small.png",
        "large": "/drivers/nuos/assets/images/large.png",
        "xlarge": "/drivers/nuos/assets/images/xlarge.png"
      },
      "icon": "/drivers/nuos/assets/icon.svg",
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Ariston NET account",
              "fr": "Compte Ariston NET"
            },
            "usernameLabel": {
              "en": "E-mail",
              "fr": "E-mail"
            },
            "usernamePlaceholder": "name@example.com",
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            },
            "passwordPlaceholder": ""
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
